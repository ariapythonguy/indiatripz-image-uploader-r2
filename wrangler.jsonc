{
  "name": "indiatripz-image-uploader-r2",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "images-indiatripz"
    }
  ],
  "vars": {
    "SHEETS_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbyhNugkXY4-W4tNTYGZyOFfJGW0yKnO4oIjAoPVG26Xkgsnp2dAovgpNyTWHuy8z4Ba9g/exec",
    "PUBLIC_R2_URL": "https://images.indiatripz.com",
    "UPLOAD_SECRET": "LetsWork01"
  }
}
